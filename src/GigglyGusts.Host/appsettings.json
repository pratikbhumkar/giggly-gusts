{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Health": {
    "IncludeDiagnostics": false
  },
  "Weather": {
    "UseOpenMeteo": false,
    "MaintenanceMode": false,
    "CacheSeconds": 120,
    "OpenMeteo": {
      "BaseUrl": "https://api.open-meteo.com"
    },
    "Http": {
      "AttemptTimeoutMs": 1500,
      "MaxRetries": 2,
      "BackoffBaseMs": 100,
      "BackoffMaxMs": 1000,
      "RetryOn429": false
    }
  }
}
